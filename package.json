{
  "name": "vibe-tube-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.ts",
  "scripts": {
    "install-dependency-prod": "npm install --omit=dev",
    "build": "tsc && echo 'TypeScript compilation complete!' && npm run install-dependency-prod",
    "clean": "npx rimraf build",
    "rebuild": "npm run clean && npm run build",
    "start": "nodemon build/index.js",
    "dev": "tsx index.ts",
    "lint": "eslint --ext .ts --fix .",
    "prettier": "prettier --write --ignore-unknown .",
    "create-lambda-layer": "mkdir nodejs && copy package.json nodejs\\ && npm install --omit=dev --prefix nodejs && del nodejs\\package.json && del nodejs\\package-lock.json && powershell -Command \"Compress-Archive -Path nodejs -DestinationPath layer.zip\" && rimraf nodejs"
  },
  "dependencies": {
    "@types/cookie-parser": "^1.4.10",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "google-auth-library": "^10.6.2",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "nodemon": "^3.1.14",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "serverless-http": "^4.0.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.19.15",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^10.0.0",
    "@types/validator": "^13.15.10",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
